{
    "$schema": "https://opencode.ai/config.json",
    "model": "opencode-go/kimi-k2.7-code",
    "small_model": "opencode/deepseek-v4-flash-free",
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ]
        },
        "playwright": {
            "type": "local",
            "enabled": true,
            "command": [
                "npx",
                "-y",
                "@playwright/mcp@latest",
                "--headless"
            ]
        }
    }
}